<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Solicitud #<%= inv.id %> &mdash; <%= branding.nombre %></title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Arial,sans-serif;background:var(--bg-body);color:var(--text-main);min-height:100vh;}
.topbar{background:var(--bg-card);border-bottom:2px solid var(--color-principal);padding:14px 28px;display:flex;align-items:center;gap:16px;}
.topbar .sub{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px;}
.topbar .user{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:12px;color:var(--text-sub);}
.topbar a.btn-back{padding:6px 14px;border-radius:6px;background:var(--bg-hover);color:var(--text-sub);font-size:11px;font-weight:700;text-decoration:none;border:1px solid var(--border);}
.topbar a.btn-logout{padding:6px 14px;border-radius:6px;background:var(--color-principal);color:#fff;font-size:11px;font-weight:700;text-decoration:none;}

.page{max-width:1100px;margin:28px auto;padding:0 20px;display:grid;grid-template-columns:1fr 380px;gap:20px;align-items:start;}
.col-left{display:flex;flex-direction:column;gap:16px;}
.col-right{display:flex;flex-direction:column;gap:16px;position:sticky;top:20px;}

.card{background:var(--bg-card);border-radius:10px;padding:24px;border:1px solid var(--border);}
.card-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--color-principal);margin-bottom:16px;}

/* Header de solicitud */
.sol-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px;gap:12px;}
.sol-header-left{display:flex;flex-direction:column;gap:6px;}
.sol-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.sol-fecha{font-size:11px;color:var(--text-muted);}

.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.info-item label{display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:3px;}
.info-item .val{font-size:13px;color:var(--text-main);}

.badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;}
.badge-pendiente_cotizacion{background:rgba(255,152,0,0.12);color:#e65100;border:1px solid rgba(255,152,0,0.3);}
.badge-pendiente_aprobacion,.badge-pendiente_aprobacion_cotizacion,.badge-pendiente_aprobacion_pago{background:rgba(0,123,255,0.12);color:#0056b3;border:1px solid rgba(0,123,255,0.3);}
.badge-en_compra{background:rgba(103,58,183,0.12);color:#673ab7;border:1px solid rgba(103,58,183,0.3);}
.badge-pendiente_pago{background:rgba(255,193,7,0.15);color:#856404;border:1px solid rgba(255,193,7,0.4);}
.badge-pagado{background:rgba(40,167,69,0.12);color:#155724;border:1px solid rgba(40,167,69,0.3);}
.badge-entregado{background:rgba(0,188,212,0.12);color:#00838f;border:1px solid rgba(0,188,212,0.3);}
.badge-rechazado{background:rgba(220,53,69,0.12);color:#721c24;border:1px solid rgba(220,53,69,0.3);}
.badge-flujo{font-size:10px;color:var(--text-muted);background:var(--bg-dark2);padding:3px 10px;border-radius:20px;border:1px solid var(--border);}

.form-group{margin-bottom:12px;}
.form-group label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:5px;}
input[type=text],input[type=number],textarea{width:100%;padding:9px 12px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg-input);color:var(--text-main);font-size:13px;outline:none;font-family:inherit;}
input[type=text]:focus,input[type=number]:focus,textarea:focus{border-color:var(--color-principal);}
input[type=file]{width:100%;padding:8px;border-radius:7px;border:1.5px dashed var(--border);background:var(--bg-input);color:var(--text-main);font-size:12px;cursor:pointer;}
textarea{resize:vertical;min-height:70px;}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
.btn{padding:10px 16px;border-radius:7px;border:none;font-size:12px;font-weight:700;cursor:pointer;width:100%;}
.btn-success{background:rgba(40,167,69,0.15);color:#155724;border:1px solid rgba(40,167,69,0.4);}
.btn-success:hover{background:rgba(40,167,69,0.25);}
.btn-danger{background:rgba(220,53,69,0.1);color:#721c24;border:1px solid rgba(220,53,69,0.3);}
.btn-danger:hover{background:rgba(220,53,69,0.2);}
.btn-primary{background:var(--color-principal);color:#fff;border:none;}
.btn-primary:hover{opacity:0.9;}
.btn-sm{padding:8px 14px;font-size:11px;}

.tab-btns{display:flex;gap:0;border:1px solid var(--border);border-radius:7px;overflow:hidden;margin-bottom:14px;}
.tab-btn{flex:1;padding:8px 4px;font-size:11px;font-weight:700;cursor:pointer;background:var(--bg-input);border:none;color:var(--text-sub);transition:all 0.15s;line-height:1.3;}
.tab-btn.active{background:var(--color-principal);color:#fff;}
.tab-panel{display:none;} .tab-panel.active{display:block;}
.file-link{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:6px;border:1px solid var(--border);background:var(--bg-input);color:var(--color-principal);font-size:12px;font-weight:700;text-decoration:none;}
.file-link:hover{border-color:var(--color-principal);}
.file-hint{font-size:11px;color:var(--text-muted);margin-top:4px;}

.estado-final{text-align:center;padding:20px 16px;}
.estado-final .icono{font-size:36px;margin-bottom:8px;}
.estado-final .titulo{font-size:14px;font-weight:800;margin-bottom:4px;}
.estado-final .sub{font-size:12px;color:var(--text-muted);}

@media(max-width:780px){
  .page{grid-template-columns:1fr;}
  .col-right{position:static;}
}
</style>
<%- include('../partials/branding') %>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:12px;">
    <a href="/"><img src="<%= branding.logo %>" alt="<%= branding.nombre %>" style="height:36px;object-fit:contain;"></a>
    <div><div style="font-weight:700;font-size:14px;">Solicitud #<%= inv.id %></div><div class="sub">Inversiones</div></div>
  </div>
  <div class="user">
    <span><%= session.nagsa_name || session.nagsa_user %></span>
    <button onclick="toggleTema()" title="Cambiar tema" style="background:none;border:1px solid var(--border);border-radius:6px;padding:5px 10px;cursor:pointer;font-size:14px;color:var(--text-sub);line-height:1;"><%- branding.tema === 'oscuro' ? '&#x1F319;' : '&#x2600;&#xFE0F;' %></button>
    <a href="/inversiones" class="btn-back">&larr; Volver</a>
    <a href="/logout" class="btn-logout">Salir</a>
  </div>
</div>

<%
function estadoLabel(e) {
  const m = {
    'pendiente_cotizacion':           'Pendiente',
    'pendiente_aprobacion_cotizacion':'Cotización enviada',
    'en_compra':                      'En compra',
    'pendiente_aprobacion_pago':      'Factura subida',
    'pendiente_aprobacion':           'En aprobación',
    'pendiente_pago':                 'Pendiente de pago',
    'pagado':                         'Pagado',
    'entregado':                      'Entregado desde stock',
    'rechazado':                      'Rechazado',
  };
  return m[e] || e.replace(/_/g,' ');
}
function fmtFecha(f) { return f ? new Date(f).toLocaleDateString('es-EC') : '—'; }
function fmtFechaHora(f) { return f ? new Date(f).toLocaleString('es-EC') : '—'; }
%>

<div class="page">

  <!-- COLUMNA IZQUIERDA — Información -->
  <div class="col-left">

    <!-- Info general -->
    <div class="card">
      <div class="sol-header">
        <div class="sol-header-left">
          <div class="sol-meta">
            <span class="badge badge-<%= inv.estado %>"><%= estadoLabel(inv.estado) %></span>
            <span class="badge-flujo">Flujo <%= inv.flujo %> &mdash; <%= inv.flujo==='A' ? 'Con cotización' : 'Compra directa' %></span>
          </div>
          <div class="sol-fecha">Solicitado el <%= fmtFechaHora(inv.created_at) %></div>
        </div>
      </div>
      <div class="info-grid">
        <div class="info-item"><label>Empresa</label><div class="val"><%= inv.empresa %></div></div>
        <div class="info-item"><label>Solicitado por</label><div class="val"><%= inv.solicitado_nombre %> <span style="color:var(--text-muted);font-size:11px;">(<%= inv.solicitado_por %>)</span></div></div>
        <div class="info-item" style="grid-column:span 2"><label>Descripción</label><div class="val"><%= inv.descripcion %></div></div>
        <% if (inv.justificacion) { %>
        <div class="info-item" style="grid-column:span 2"><label>Justificación</label><div class="val" style="white-space:pre-wrap;"><%= inv.justificacion %></div></div>
        <% } %>
        <% if (inv.solicitud_adjunto) {
          let adjuntos = [];
          try { adjuntos = JSON.parse(inv.solicitud_adjunto); } catch { adjuntos = [inv.solicitud_adjunto]; }
        %>
        <div class="info-item" style="grid-column:span 2">
          <label>Fotos / adjuntos</label>
          <div class="val" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px;">
            <% adjuntos.forEach(function(archivo) {
              const esImagen = /\.(jpg|jpeg|png|webp)$/i.test(archivo);
            %>
              <% if (esImagen) { %>
                <a href="/uploads/inversiones/<%= archivo %>" target="_blank">
                  <img src="/uploads/inversiones/<%= archivo %>" style="height:80px;width:80px;object-fit:cover;border-radius:7px;border:1px solid var(--border);">
                </a>
              <% } else { %>
                <a href="/uploads/inversiones/<%= archivo %>" target="_blank" class="file-link">&#128196; Ver archivo</a>
              <% } %>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Artículos solicitados -->
    <% if (items && items.length) { %>
    <div class="card">
      <div class="card-title">Artículos solicitados</div>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr>
            <th style="text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-muted);padding:6px 8px;border-bottom:1px solid var(--border);">Descripción</th>
            <th style="text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-muted);padding:6px 8px;border-bottom:1px solid var(--border);width:70px;">Cant.</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(item) { %>
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:8px;font-size:13px;"><%= item.descripcion %></td>
            <td style="padding:8px;font-size:13px;text-align:center;font-weight:700;"><%= item.cantidad %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- Cotización -->
    <% if (inv.cotizacion_monto) { %>
    <div class="card">
      <div class="card-title">Cotización</div>
      <div class="info-grid">
        <div class="info-item"><label>Proveedor</label><div class="val"><%= inv.cotizacion_proveedor %></div></div>
        <div class="info-item"><label>Monto</label><div class="val" style="font-size:20px;font-weight:800;color:var(--color-principal);">$<%= Number(inv.cotizacion_monto).toFixed(2) %></div></div>
        <% if (inv.cotizacion_detalle) { %><div class="info-item" style="grid-column:span 2"><label>Detalle</label><div class="val"><%= inv.cotizacion_detalle %></div></div><% } %>
        <div class="info-item"><label>Cotizado por</label><div class="val"><%= inv.cotizado_por %></div></div>
        <div class="info-item"><label>Fecha</label><div class="val"><%= fmtFecha(inv.cotizado_at) %></div></div>
        <% if (inv.cotizacion_archivo) { %>
        <div class="info-item" style="grid-column:span 2">
          <label>Documento</label>
          <div class="val" style="margin-top:4px;"><a href="/uploads/inversiones/<%= inv.cotizacion_archivo %>" target="_blank" class="file-link">&#128196; Ver cotización</a></div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Factura -->
    <% if (inv.factura_archivo) { %>
    <div class="card">
      <div class="card-title">Factura</div>
      <div class="info-grid">
        <div class="info-item"><label>Subida por</label><div class="val"><%= inv.factura_subida_por %></div></div>
        <div class="info-item"><label>Fecha</label><div class="val"><%= fmtFecha(inv.factura_subida_at) %></div></div>
        <div class="info-item" style="grid-column:span 2">
          <label>Archivo</label>
          <div class="val" style="margin-top:4px;"><a href="/uploads/inversiones/<%= inv.factura_archivo %>" target="_blank" class="file-link">&#128196; Ver factura</a></div>
        </div>
      </div>
    </div>
    <% } %>

  </div>

  <!-- COLUMNA DERECHA — Acción / Estado -->
  <div class="col-right">

    <!-- Estado final: Pagado -->
    <% if (inv.estado === 'pagado') { %>
    <div class="card">
      <div class="estado-final">
        <div class="icono">&#10003;</div>
        <div class="titulo" style="color:#28a745;">Pagado</div>
        <div class="sub" style="margin-top:8px;">Marcado por <strong><%= inv.marcado_pagado_por %></strong><br><%= fmtFecha(inv.marcado_pagado_at) %></div>
      </div>
    </div>
    <% } %>

    <!-- Estado final: Entregado desde stock -->
    <% if (inv.estado === 'entregado') { %>
    <div class="card">
      <div class="estado-final">
        <div class="icono">&#128230;</div>
        <div class="titulo" style="color:#00838f;">Entregado desde stock</div>
        <div class="sub" style="margin-top:8px;"><strong><%= inv.glpi_consumible_nombre || '—' %></strong><br>Por <%= inv.entregado_por %> &mdash; <%= fmtFecha(inv.entregado_at) %></div>
      </div>
    </div>
    <% } %>

    <!-- Estado final: Rechazado -->
    <% if (inv.estado === 'rechazado') { %>
    <div class="card">
      <div class="estado-final">
        <div class="icono">&#10007;</div>
        <div class="titulo" style="color:#dc3545;">Rechazado</div>
        <% if (inv.motivo_rechazo) { %><div class="sub" style="margin-top:8px;"><%= inv.motivo_rechazo %></div><% } %>
        <div class="sub" style="margin-top:6px;">Por <%= inv.rechazado_por %> &mdash; <%= fmtFecha(inv.rechazado_at) %></div>
      </div>
    </div>
    <% } %>

    <!-- Acciones activas -->
    <% if (!['rechazado','pagado','entregado'].includes(inv.estado)) { %>

      <!-- TI: Pendiente cotización -->
      <% if (rolInfo.puede_cotizar && inv.estado === 'pendiente_cotizacion') { %>
      <div class="card">
        <div class="card-title">Acción TI</div>
        <div class="tab-btns">
          <button class="tab-btn active" onclick="mostrarTab('cotizar')">Cotizar</button>
          <button class="tab-btn" onclick="mostrarTab('directa')">Compra directa</button>
          <button class="tab-btn" onclick="mostrarTab('stock')">Stock GLPI</button>
        </div>

        <div id="panel-cotizar" class="tab-panel active">
          <p style="font-size:11px;color:var(--text-sub);margin-bottom:12px;">Registra la cotización. Gerencia deberá aprobarla antes de comprar.</p>
          <form id="formCotizar">
            <div class="form-group"><label>Proveedor *</label><input type="text" name="proveedor" required placeholder="Nombre del proveedor"></div>
            <div class="form-group"><label>Monto total *</label><input type="number" name="monto" step="0.01" min="0" required placeholder="0.00"></div>
            <div class="form-group"><label>Detalle</label><textarea name="detalle" placeholder="Especificaciones, N° cotización, etc." style="min-height:55px;"></textarea></div>
            <div class="form-group">
              <label>Documento (PDF / imagen)</label>
              <input type="file" name="cotizacion_archivo" accept=".pdf,.jpg,.jpeg,.png,.webp">
            </div>
            <div class="btn-row" style="flex-direction:column;">
              <button type="submit" class="btn btn-primary">Enviar cotización</button>
              <button type="button" class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar solicitud</button>
            </div>
          </form>
        </div>

        <div id="panel-directa" class="tab-panel">
          <p style="font-size:11px;color:var(--text-sub);margin-bottom:12px;">Compra ya realizada con caja chica. Sube la factura para aprobación de pago.</p>
          <form id="formDirecta">
            <div class="form-group">
              <label>Factura *</label>
              <input type="file" name="factura_archivo" accept=".pdf,.jpg,.jpeg,.png,.webp" required>
            </div>
            <div class="btn-row" style="flex-direction:column;">
              <button type="submit" class="btn btn-primary">Registrar compra directa</button>
              <button type="button" class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar solicitud</button>
            </div>
          </form>
        </div>

        <div id="panel-stock" class="tab-panel">
          <p style="font-size:11px;color:var(--text-sub);margin-bottom:12px;">Artículo en stock. Selecciónalo en GLPI para asignarlo al usuario automáticamente.</p>
          <div class="form-group">
            <label>Buscar en GLPI *</label>
            <input type="text" id="stockBuscar" placeholder="Ej: mouse, cable, ups..." autocomplete="off">
            <div id="stockResultados" style="margin-top:4px;border:1px solid var(--border);border-radius:7px;overflow:hidden;display:none;max-height:200px;overflow-y:auto;"></div>
          </div>
          <div id="stockSeleccionado" style="display:none;padding:10px 12px;background:rgba(0,188,212,0.08);border:1px solid rgba(0,188,212,0.3);border-radius:7px;margin-bottom:10px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#00838f;margin-bottom:2px;">Seleccionado</div>
            <div id="stockSelNombre" style="font-size:13px;font-weight:700;"></div>
            <div id="stockSelStock" style="font-size:11px;color:var(--text-muted);"></div>
          </div>
          <input type="hidden" id="stockConsumableId">
          <input type="hidden" id="stockConsumableNombre">
          <div class="btn-row" style="flex-direction:column;">
            <button type="button" class="btn btn-primary" id="btnEntregarStock" onclick="entregarStock()" disabled>Entregar desde stock</button>
            <button type="button" class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar solicitud</button>
          </div>
        </div>
      </div>
      <% } %>

      <!-- TI: En compra → Subir factura -->
      <% if (rolInfo.puede_cotizar && inv.estado === 'en_compra') { %>
      <div class="card">
        <div class="card-title">Acción TI</div>
        <p style="font-size:12px;color:var(--text-sub);margin-bottom:12px;">Cotización aprobada. Sube la factura de la compra.</p>
        <form id="formFactura">
          <div class="form-group">
            <label>Factura *</label>
            <input type="file" name="factura_archivo" accept=".pdf,.jpg,.jpeg,.png,.webp" required>
          </div>
          <div class="btn-row" style="flex-direction:column;">
            <button type="submit" class="btn btn-primary">Confirmar compra y subir factura</button>
            <button type="button" class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar</button>
          </div>
        </form>
      </div>
      <% } %>

      <!-- Gerente: Aprobar cotización -->
      <% if (rolInfo.puede_aprobar_cotizacion && inv.estado === 'pendiente_aprobacion_cotizacion') { %>
      <div class="card">
        <div class="card-title">Acción Gerencia</div>
        <p style="font-size:12px;color:var(--text-sub);margin-bottom:16px;">TI presentó la cotización. Revise el monto y proveedor antes de aprobar.</p>
        <div class="btn-row" style="flex-direction:column;">
          <button class="btn btn-success" onclick="accion('aprobar-cotizacion')">Aprobar cotización</button>
          <button class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar</button>
        </div>
      </div>
      <% } %>

      <!-- Gerente: Aprobar pago -->
      <% if (rolInfo.puede_aprobar_pago && ['pendiente_aprobacion_pago','pendiente_aprobacion'].includes(inv.estado)) { %>
      <div class="card">
        <div class="card-title">Acción Gerencia</div>
        <p style="font-size:12px;color:var(--text-sub);margin-bottom:16px;">La factura fue registrada. ¿Aprueba el pago de esta compra?</p>
        <div class="btn-row" style="flex-direction:column;">
          <button class="btn btn-success" onclick="accion('aprobar')">Aprobar pago</button>
          <button class="btn btn-danger btn-sm" onclick="rechazar()">Rechazar</button>
        </div>
      </div>
      <% } %>

      <!-- Contadora: Marcar pagado -->
      <% if (rolInfo.puede_marcar_pagado && inv.estado === 'pendiente_pago') { %>
      <div class="card">
        <div class="card-title">Acción Contadora</div>
        <p style="font-size:12px;color:var(--text-sub);margin-bottom:16px;">Gerencia aprobó el pago. Confirma cuando hayas procesado el pago.</p>
        <div class="btn-row" style="flex-direction:column;">
          <button class="btn btn-success" onclick="accion('marcar-pagado')">Marcar como pagado</button>
        </div>
      </div>
      <% } %>

      <!-- Sin acción pendiente para este usuario -->
      <% if (!rolInfo.puede_cotizar && !rolInfo.puede_aprobar_cotizacion && !rolInfo.puede_aprobar_pago && !rolInfo.puede_marcar_pagado) { %>
      <div class="card" style="text-align:center;padding:20px;">
        <div style="font-size:24px;margin-bottom:8px;">&#8987;</div>
        <div style="font-size:13px;font-weight:700;">En proceso</div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Tu solicitud está siendo atendida</div>
      </div>
      <% } %>

    <% } %>

  </div>
</div>

<script>
const id = <%= inv.id %>;

function mostrarTab(tab) {
  const tabs = ['cotizar', 'directa', 'stock'];
  document.querySelectorAll('.tab-btn').forEach((b, i) => b.classList.toggle('active', tabs[i] === tab));
  tabs.forEach(t => {
    const p = document.getElementById('panel-' + t);
    if (p) p.classList.toggle('active', t === tab);
  });
}

let stockTimer = null;
const stockBuscar = document.getElementById('stockBuscar');
if (stockBuscar) {
  stockBuscar.addEventListener('input', () => {
    clearTimeout(stockTimer);
    const q = stockBuscar.value.trim();
    if (q.length < 2) { document.getElementById('stockResultados').style.display = 'none'; return; }
    stockTimer = setTimeout(() => buscarConsumibles(q), 350);
  });
}

async function buscarConsumibles(q) {
  const box = document.getElementById('stockResultados');
  box.style.display = 'block';
  box.innerHTML = '<div style="padding:10px 14px;font-size:12px;color:var(--text-muted);">Buscando...</div>';
  try {
    const r = await fetch(`/inversiones/glpi-consumibles?q=${encodeURIComponent(q)}`);
    const lista = await r.json();
    if (!lista.length) {
      box.innerHTML = '<div style="padding:10px 14px;font-size:12px;color:var(--text-muted);">Sin resultados</div>';
      return;
    }
    box.innerHTML = lista.map(c => {
      const nombre = c.name + (c.ref ? ` (${c.ref})` : '');
      const nombreSafe = nombre.replace(/'/g, "\\'");
      const meta = [c.grupo, c.ubicacion].filter(Boolean).join(' — ');
      return `
        <div onclick="seleccionarConsumible(${c.id}, '${nombreSafe}', ${c.disponibles})"
          style="padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--border);"
          onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:13px;font-weight:700;">${c.name}${c.ref ? ` <span style="color:var(--text-muted);font-weight:400;">(${c.ref})</span>` : ''}</span>
            <span style="font-size:11px;color:#00838f;font-weight:700;white-space:nowrap;margin-left:8px;">${c.disponibles} disp.</span>
          </div>
          ${meta ? `<div style="font-size:11px;color:var(--text-muted);margin-top:2px;">${meta}</div>` : ''}
        </div>`;
    }).join('');
  } catch {
    box.innerHTML = '<div style="padding:10px 14px;font-size:12px;color:#dc3545;">Error al buscar</div>';
  }
}

function seleccionarConsumible(cid, nombre, disponibles) {
  document.getElementById('stockConsumableId').value = cid;
  document.getElementById('stockConsumableNombre').value = nombre;
  document.getElementById('stockSelNombre').textContent = nombre;
  document.getElementById('stockSelStock').textContent = disponibles + ' unidad' + (disponibles != 1 ? 'es' : '') + ' disponible' + (disponibles != 1 ? 's' : '');
  document.getElementById('stockSeleccionado').style.display = 'block';
  document.getElementById('stockResultados').style.display = 'none';
  document.getElementById('stockBuscar').value = nombre;
  document.getElementById('btnEntregarStock').disabled = false;
}

async function entregarStock() {
  const cid = document.getElementById('stockConsumableId').value;
  const cnombre = document.getElementById('stockConsumableNombre').value;
  if (!cid) { toast('Selecciona un consumible', 'error'); return; }
  const btn = document.getElementById('btnEntregarStock');
  btn.disabled = true; btn.textContent = 'Procesando...';
  try {
    const r = await fetch(`/inversiones/${id}/entregar-stock`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ consumable_id: cid, consumable_nombre: cnombre }),
    });
    const res = await r.json();
    if (res.ok) location.reload();
    else { toast(res.error || 'Error', 'error'); btn.disabled = false; btn.textContent = 'Entregar desde stock'; }
  } catch { toast('Error de conexión', 'error'); btn.disabled = false; btn.textContent = 'Entregar desde stock'; }
}

async function accion(endpoint) {
  if (!confirm('¿Confirmar acción?')) return;
  const r = await fetch(`/inversiones/${id}/${endpoint}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
  const res = await r.json();
  if (res.ok) location.reload();
  else { toast(res.error || 'Error', 'error'); }
}

async function rechazar() {
  const motivo = prompt('Motivo del rechazo (opcional):');
  if (motivo === null) return;
  const r = await fetch(`/inversiones/${id}/rechazar`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ motivo }),
  });
  const res = await r.json();
  if (res.ok) location.reload();
  else { toast(res.error || 'Error', 'error'); }
}

async function enviarForm(formEl, endpoint) {
  const btn = formEl.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = 'Enviando...';
  try {
    const r = await fetch(`/inversiones/${id}/${endpoint}`, { method: 'POST', body: new FormData(formEl) });
    const res = await r.json();
    if (res.ok) location.reload();
    else { toast(res.error || 'Error', 'error'); btn.disabled = false; btn.textContent = 'Enviar'; }
  } catch { toast('Error de conexión', 'error'); btn.disabled = false; }
}

const fCotizar = document.getElementById('formCotizar');
if (fCotizar) fCotizar.addEventListener('submit', e => { e.preventDefault(); enviarForm(fCotizar, 'cotizar'); });
const fDirecta = document.getElementById('formDirecta');
if (fDirecta) fDirecta.addEventListener('submit', e => { e.preventDefault(); enviarForm(fDirecta, 'compra-directa'); });
const fFactura = document.getElementById('formFactura');
if (fFactura) fFactura.addEventListener('submit', e => { e.preventDefault(); enviarForm(fFactura, 'marcar-comprado'); });
</script>
</body>
</html>
