  });
}

function quitarJefe(gid, username, nombre) {
  confirmar('Quitar jefe', 'Quitar a ' + (nombre || username) + ' como jefe del grupo?', async function() {
    await fetch('/permisos/api/grupo/quitar-jefe', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ grupo_id: gid, username }),
    });
    toast((nombre || username) + ' removido como jefe');
    cargarArbol();
  });
}

async function editarNombreGrupo(gid, nombreActual, empresaActual) {
  document.getElementById('input-grupo-nombre').value = nombreActual;
  document.getElementById('modal-grupo-titulo').textContent = 'Editar Grupo';
  // Cargar empresas en el dropdown
  const sel = document.getElementById('select-grupo-empresa');
  sel.innerHTML = '<option value="">-- Sin empresa --</option>';
  try {
    const resp = await fetch('/permisos/api/glpi-entidades');
    const entidades = await resp.json();
    entidades.forEach(e => {
      const opt = document.createElement('option');
      opt.value = e.nombre; opt.textContent = e.nombre;
      if (e.nombre === empresaActual) opt.selected = true;
      sel.appendChild(opt);
    });
  } catch {}
  if (empresaActual) sel.value = empresaActual;
  document.getElementById('modal-grupo').classList.add('show');
  const btnGuardar = document.querySelector('#modal-grupo .btn-primary');
  btnGuardar.onclick = async function() {
    const nombre = document.getElementById('input-grupo-nombre').value.trim();
    if (!nombre) return;
    const empresa = document.getElementById('select-grupo-empresa').value || null;
    await fetch('/permisos/api/grupo/editar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ grupo_id: gid, nombre, empresa }),
    });
    cerrarModal('modal-grupo');
    toast('Grupo actualizado');
    btnGuardar.onclick = function() { guardarGrupo(); };
    document.getElementById('modal-grupo-titulo').textContent = 'Crear Grupo';
    cargarArbol();
  };
  setTimeout(() => document.getElementById('input-grupo-nombre').focus(), 100);
}

function quitarMiembro(gid, username, nombre) {
  confirmar('Quitar miembro', 'Quitar a ' + (nombre || username) + ' del grupo?', async function() {
    await fetch('/permisos/api/grupo/quitar-miembro', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ grupo_id: gid, username }),
    });
    toast((nombre || username) + ' removido del grupo');
    cargarArbol();
  });
}

async function cambiarPermGrupo(gid, perm, valor) {
  const permisos = {};
  permisos[perm] = valor;
  await fetch('/permisos/api/grupo/permisos', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ grupo_id: gid, permisos }),
  });
  toast('Permiso actualizado');
  cargarArbol();
}

async function habilitarInversiones(gid) {
  await fetch('/permisos/api/grupo/permisos', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ grupo_id: gid, permisos: { puede_aprobar_cotizacion: true } }),
  });
  cargarArbol();
}

// Tabs
function switchTab(tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  const tabs = document.querySelectorAll('.tab');
  const nombres = { arbol: 'Jerarquía', modulos: 'Módulos', configuracion: 'Configuración', notificaciones: 'Notificaciones' };
  tabs.forEach(t => { if (t.textContent.includes(nombres[tab] || '')) t.classList.add('active'); });
  if (tab === 'modulos' && !todosUsuarios.length) cargarTablaUsuarios();
  if (tab === 'configuracion') cargarMotivos();
}

// Sin grupo — helpers usados por renderArbol()
let _sgData = null;

function sgToggle(id) {
  const b = document.getElementById(id);
  if (b) b.style.display = b.style.display === 'none' ? 'block' : 'none';
}

function sgColapsable(empresa, usuarios) {
  const bid = 'sg-body-' + empresa.replace(/[^a-zA-Z0-9]/g, '_');

  // Todos los grupos de todas las empresas, agrupados con optgroup (excluye sistema)
  const SISTEMA = ['Gerencia', 'Contadora'];
  const porEmp = {};
  for (const [gid, g] of Object.entries(arbol.grupos || {})) {
    if (SISTEMA.includes(g.nombre)) continue;
    const e = g.empresa || 'Sin empresa';
    if (!porEmp[e]) porEmp[e] = [];
    porEmp[e].push({ gid, nombre: g.nombre });
  }
  let optsHtml = '<option value="">— seleccionar grupo —</option>';
  for (const [emp, gs] of Object.entries(porEmp).sort()) {
    optsHtml += '<optgroup label="' + emp + '">';
    for (const g of gs) optsHtml += '<option value="' + g.gid + '">' + g.nombre + '</option>';
    optsHtml += '</optgroup>';
  }
  const hayGrupos = Object.keys(porEmp).length > 0;

  let h = '<div class="grupo-card" style="border-left:3px solid #e65100;margin-bottom:8px;">';
  h += '<div class="grupo-header" onclick="sgToggle(\'' + bid + '\')" style="background:rgba(230,81,0,0.05);gap:12px;">';
  h += '<span style="font-size:16px;">&#9888;</span>';
  h += '<div style="flex:1;"><div style="font-size:13px;font-weight:700;color:#e65100;">Sin grupo asignado</div>';
  h += '<div style="font-size:11px;color:var(--text-muted);">' + usuarios.length + ' usuario(s) pendiente(s)</div></div>';
  h += '<span style="font-size:12px;font-weight:800;color:#fff;background:#e65100;border-radius:12px;padding:2px 9px;margin-right:8px;">' + usuarios.length + '</span>';
  h += '<span style="font-size:11px;color:var(--text-muted);">&#9660;</span>';
  h += '</div>';

  h += '<div id="' + bid + '" style="display:none;border-top:1px solid rgba(230,81,0,0.2);">';
  for (const u of usuarios) {
    const uid = 'sg-u-' + u.username.replace(/[^a-zA-Z0-9]/g, '_');
    h += '<div id="' + uid + '" style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-bottom:1px solid var(--border);flex-wrap:wrap;">';
    h += '<div style="width:32px;height:32px;border-radius:50%;background:rgba(230,81,0,0.12);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;">&#128100;</div>';
    h += '<div style="flex:1;min-width:120px;">';
    h += '<div style="font-size:12px;font-weight:700;color:var(--text-main);">' + (u.nombre || '—') + '</div>';
    h += '<div style="font-size:10px;color:var(--text-muted);font-family:monospace;">' + u.username + '</div>';
    h += '</div>';
    if (hayGrupos) {
      h += '<select id="sel-' + uid + '" style="padding:5px 8px;border-radius:6px;border:1.5px solid var(--border);background:var(--bg-input);color:var(--text-main);font-size:11px;outline:none;max-width:200px;">' + optsHtml + '</select>';
      h += '<select id="rol-' + uid + '" style="padding:5px 8px;border-radius:6px;border:1.5px solid var(--border);background:var(--bg-input);color:var(--text-main);font-size:11px;outline:none;width:88px;">'
        + '<option value="miembro">Miembro</option><option value="jefe">Jefe</option></select>';
      h += '<button class="btn btn-primary btn-sm" onclick="sgAsignar(\'' + u.username + '\',\'' + (u.nombre||u.username).replace(/'/g,"\\'") + '\',\'' + empresa.replace(/'/g,"\\'") + '\',\'' + uid + '\')">Asignar</button>';
    } else {
      h += '<span style="font-size:11px;color:var(--text-muted);font-style:italic;">Sin grupos creados</span>';
    }
    h += '</div>';
  }
  h += '</div></div>';
  return h;
}

async function sgAsignar(username, nombre, empresa, uid) {
  const sel = document.getElementById('sel-' + uid);
  const rol = document.getElementById('rol-' + uid);
  if (!sel || !sel.value) { toast('Selecciona un grupo', 'error'); return; }
  const grupo_id = sel.value;
  const esJefe = rol && rol.value === 'jefe';
  const endpoint = esJefe ? '/permisos/api/grupo/agregar-jefe' : '/permisos/api/grupo/miembro';
  try {
    const res = await fetch(endpoint, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ grupo_id, username, nombre, empresa }),
    });
    if (!res.ok) throw new Error(await res.text());
    toast(nombre + ' asignado como ' + (esJefe ? 'Jefe' : 'Miembro'));
    cargarArbol();
  } catch(e) { toast('Error: ' + e.message, 'error'); }
}

function sgUsuariosHtml(usuarios) {
  let h = '<div style="padding:8px 0;">';
  for (const u of usuarios) {
    h += '<div style="display:flex;gap:10px;align-items:center;padding:5px 0;font-size:12px;border-bottom:1px solid var(--border);">'
      + '<span style="font-size:14px;">&#128100;</span>'
      + '<span style="font-weight:600;color:var(--text-main);flex:1;">' + (u.nombre || '—') + '</span>'
      + '<span style="color:var(--text-muted);font-family:monospace;font-size:11px;">' + u.username + '</span>'
      + '</div>';
  }
  h += '</div>';
  return h;
}

// Motivos de salida
let motivosData = [];

async function cargarMotivos() {
  try {
    const res = await fetch('/permisos/api/motivos');
    motivosData = await res.json();
    renderMotivos();
  } catch(e) {}
}

function renderMotivos() {
  const el = document.getElementById('motivos-list');
  if (!el) return;
  if (!motivosData.length) {
    el.innerHTML = '<div style="padding:12px;text-align:center;color:var(--text-muted);font-size:12px;">No hay motivos configurados.</div>';
    return;
  }
  el.innerHTML = motivosData.map((m, i) => {
    const tipoBadge = m.tipo === 'interno'
      ? '<span class="badge badge-on" style="margin-left:8px;">Interno</span>'
      : '<span class="badge badge-ti" style="margin-left:8px;">Externo</span>';
    return '<div class="tree-item" style="margin-bottom:4px;"><div class="info"><span style="font-size:14px;">&#128196;</span><span class="name">' + m.nombre + '</span>' + tipoBadge + '</div>' +
    '<button class="btn btn-danger btn-sm" onclick="quitarMotivo(' + i + ')">Quitar</button></div>';
  }).join('');
}

async function agregarMotivo() {
  const input = document.getElementById('input-nuevo-motivo');
  const tipoSel = document.getElementById('input-nuevo-tipo');
  const valor = input.value.trim();
  if (!valor) return;
  motivosData.push({ nombre: valor, tipo: tipoSel.value });
  input.value = '';
  await guardarMotivos();
  renderMotivos();
  toast('Motivo agregado');
}

function quitarMotivo(idx) {
  motivosData.splice(idx, 1);
  guardarMotivos();
  renderMotivos();
  toast('Motivo eliminado');
}

async function guardarMotivos() {
  await fetch('/permisos/api/motivos/guardar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ motivos: motivosData }),
  });
}

// Tabla de permisos de modulos
let todosUsuarios = [];

async function cargarTablaUsuarios() {
  const tbody = document.getElementById('tbody-usuarios-perm');
  if (!tbody) return;
  try {
    todosUsuarios = await fetch('/permisos/api/todos-usuarios').then(r => r.json());
    renderTablaUsuarios(todosUsuarios);
  } catch(e) { tbody.innerHTML = '<tr class="empty-row"><td colspan="9">Error al cargar usuarios</td></tr>'; }
}

function renderTablaUsuarios(users) {
  const tbody = document.getElementById('tbody-usuarios-perm');
  if (!tbody) return;
  document.getElementById('contador-usuarios').textContent = users.length + ' usuario' + (users.length !== 1 ? 's' : '');
  if (!users.length) { tbody.innerHTML = '<tr class="empty-row"><td colspan="9">No se encontraron usuarios.</td></tr>'; return; }

  const nivelBadge = n => {
    if (n === 2) return '<span class="badge badge-ti">N2</span>';
    if (n === 3) return '<span class="badge badge-jefe">N3</span>';
    return '<span class="badge badge-user">N4</span>';
  };
  const permIcon = v => v ? '<span style="color:#1e7e34;font-weight:700;">&#10003;</span>' : '<span style="color:#999;">&#10007;</span>';

  tbody.innerHTML = users.map(u => {
    const p = u.permisos || {};
    return '<tr>' +
      '<td><strong>' + u.username + '</strong></td>' +
      '<td>' + u.nombre + '</td>' +
      '<td style="text-align:center;">' + nivelBadge(u.nivel) + '</td>' +
      '<td><small style="color:var(--text-muted);">' + u.grupo + '</small></td>' +
      '<td style="text-align:center;">' + permIcon(p.etiquetas) + '</td>' +
      '<td style="text-align:center;">' + permIcon(p.actas) + '</td>' +
      '<td style="text-align:center;">' + permIcon(p.reportes) + '</td>' +
      '<td style="text-align:center;">' + permIcon(p.inversiones) + '</td>' +
      '<td style="text-align:center;">' + permIcon(p.permisos) + '</td>' +
    '</tr>';
  }).join('');
}

function filtrarTablaUsuarios() {
  const q = (document.getElementById('filtro-usuarios').value || '').toLowerCase();
  const nivel = document.getElementById('filtro-nivel').value;
  let filtered = todosUsuarios;
  if (q) filtered = filtered.filter(u => u.username.toLowerCase().includes(q) || u.nombre.toLowerCase().includes(q) || u.grupo.toLowerCase().includes(q));
  if (nivel) filtered = filtered.filter(u => u.nivel === parseInt(nivel));
  renderTablaUsuarios(filtered);
}

// Init
cargarArbol();
